{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@lania-v/runtime",
    "baseUrl": ".",
    "paths": {
      "@lania-v/vite-plugin": ["../../packages/vite-plugin/src/index.ts"],
      "@lania-v/runtime": ["../../packages/runtime/src/index.ts"],
      "@lania-v/runtime/advanced": [
        "../../packages/runtime/src/entry/advanced.ts"
      ],
      "@lania-v/runtime/internal": [
        "../../packages/runtime/src/entry/internal.ts"
      ],
      "@lania-v/runtime/testing": [
        "../../packages/runtime/src/entry/testing.ts"
      ],
      "@lania-v/shared": ["../../packages/shared/src/index.ts"],
      "@lania-v/advanced": ["../../packages/advanced/src/index.ts"],
      "@lania/store": ["../../packages/store/src/index.ts"]
    },
    "noEmit": true
  },
  "include": ["src", "vite.config.ts"]
}
