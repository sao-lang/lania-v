{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@lania-v/runtime",
    "paths": {
      "@lania-v/vite-plugin": ["../../packages/vite-plugin/src/index.ts"],
      "@lania-v/runtime": ["../../packages/runtime/src/index.ts"],
      "@lania-v/runtime/advanced": [
        "../../packages/runtime/src/entry/advanced.ts"
      ],
      "@lania-v/runtime/component": [
        "../../packages/runtime/src/component/index.ts"
      ],
      "@lania-v/runtime/core": ["../../packages/runtime/src/core/index.ts"],
      "@lania-v/runtime/dom": ["../../packages/runtime/src/dom/index.ts"],
      "@lania-v/runtime/internal": [
        "../../packages/runtime/src/entry/internal.ts"
      ],
      "@lania-v/runtime/jsx-runtime": [
        "../../packages/runtime/src/entry/jsx-runtime.ts"
      ],
      "@lania-v/reactivity": ["../../packages/reactivity/src/index.ts"],
      "@lania-v/reactivity/internal": [
        "../../packages/reactivity/src/internal.ts"
      ],
      "@lania-v/runtime/testing": [
        "../../packages/runtime/src/entry/testing.ts"
      ],
      "@lania-v/shared": ["../../packages/shared/src/index.ts"],
      "@lania-v/advanced": ["../../packages/advanced/src/index.ts"],
      "@lania-v/store": ["../../packages/store/src/index.ts"]
    },
    "noEmit": true
  },
  "include": ["src", "vite.config.ts"]
}
