{
  "name": "@lania-v/runtime",
  "version": "0.0.3",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\" && tsc -p tsconfig.json && node ../../scripts/patch-esm-specifiers.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@lania-v/shared": "^0.0.3",
    "csstype": "^3.2.3",
    "@lania-v/reactivity": "^0.0.3",
    "@lania-v/store": "^0.0.3"
  },
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/entry/index.dev.js",
      "production": "./dist/entry/index.prod.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dev": {
      "types": "./dist/entry/index.dev.d.ts",
      "import": "./dist/entry/index.dev.js",
      "default": "./dist/entry/index.dev.js"
    },
    "./prod": {
      "types": "./dist/entry/index.prod.d.ts",
      "import": "./dist/entry/index.prod.js",
      "default": "./dist/entry/index.prod.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./reactivity": {
      "types": "./dist/reactivity/index.d.ts",
      "import": "./dist/reactivity/index.js",
      "default": "./dist/reactivity/index.js"
    },
    "./component": {
      "types": "./dist/component/index.d.ts",
      "import": "./dist/component/index.js",
      "default": "./dist/component/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "import": "./dist/dom/index.js",
      "default": "./dist/dom/index.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "import": "./dist/render/index.js",
      "default": "./dist/render/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/entry/jsx-runtime.d.ts",
      "import": "./dist/entry/jsx-runtime.js",
      "default": "./dist/entry/jsx-runtime.js"
    },
    "./advanced": {
      "types": "./dist/entry/advanced.d.ts",
      "import": "./dist/entry/advanced.js",
      "default": "./dist/entry/advanced.js"
    },
    "./internal": {
      "types": "./dist/entry/internal.d.ts",
      "import": "./dist/entry/internal.js",
      "default": "./dist/entry/internal.js"
    },
    "./testing": {
      "types": "./dist/entry/testing.d.ts",
      "import": "./dist/entry/testing.js",
      "default": "./dist/entry/testing.js"
    },
    "./component/transition": {
      "types": "./dist/component/transition/index.d.ts",
      "import": "./dist/component/transition/index.js",
      "default": "./dist/component/transition/index.js"
    },
    "./component/lifecycle": {
      "types": "./dist/component/lifecycle/index.d.ts",
      "import": "./dist/component/lifecycle/index.js",
      "default": "./dist/component/lifecycle/index.js"
    }
  },
  "sideEffects": [
    "./dist/entry/index.dev.js",
    "./dist/entry/index.prod.js"
  ]
}
