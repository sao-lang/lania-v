{
  "name": "@lania-v/compiler-tsx",
  "version": "0.0.3",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\" && tsc -p tsconfig.build.json && node ../../scripts/patch-esm-specifiers.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@lania-v/compiler-core": "^0.0.3",
    "@lania-v/shared": "^0.0.3",
    "@rollup/pluginutils": "^5.1.4",
    "magic-string": "^0.30.18",
    "typescript": "^5.8.3"
  },
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false
}
